# Copy to .env (which is gitignored) and fill in real values before running `docker compose up`.
# docker-compose.yml reads these via ${VARNAME} interpolation.

# SQL Server 'sa' password. Must satisfy SQL Server's complexity policy
# (8+ chars, upper + lower + digit or symbol) or the container will refuse to start.
SA_PASSWORD=Change_Me_1

# HMAC-SHA256 signing key for JWT access tokens. Must be at least 32 characters;
# the API throws on startup otherwise. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=Change_This_To_A_Long_Random_Secret_At_Least_32_Chars

# Initial Admin account seeded on first startup if the Users table is empty.
# Leave SEED_ADMIN_PASSWORD blank to skip seeding entirely.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=Change_Me_1

# Comma-free JSON array of allowed CORS origins for the api service, e.g. ["https://app.example.com"].
# Leave as [] to allow any origin (fine for local/dev use, tighten for real deployments).
CORS_ALLOWED_ORIGINS=[]

# Defaults to Development, which serves Swagger UI at /swagger — convenient for this local/demo
# compose stack. Set to Production to test production behavior (no Swagger UI).
ASPNETCORE_ENVIRONMENT=Development
